flowchart TD
    subgraph Z["Zotero 进程"]
        A["bootstrap.js::startup()<br/>插件自动加载"] --> B["eval( start_script.js )"]
    end

    B --> C["registerNotifiers()<br/>注册 Zotero.Notifier 监听"]

    C --> T1["tab add"]
    C --> T2["tab close"]
    C --> T3["item add"]
    C --> T4["ui_startup"]

    T1 -->|"item_open"| D1["triggerWithDebounce"]
    T2 -->|"item_close"| D2["triggerWithDebounce"]
    T3 -->|"item_add"| D3["triggerWithDebounce"]
    T4 -->|"ui_startup"| D4["triggerWithDebounce"]

    D1 --> E["loadTriggerConfig()<br/>读取 config.json zotero_events.triggers"]
    D2 --> E
    D3 --> E
    D4 --> E

    E --> F["runScript()<br/>eval 执行目标脚本<br/>注入 item / items / triggerEvent"]

    F -->|"item_open"| S1["zotero_pdf_summary.js"]
    F -->|"item_add"| S2["zotero_rss.js"]
    F -->|"ui_startup"| S3["zotero_autoupdate_note.js"]
    F -->|"item_close<br/>（可配置）"| S4["（自定义脚本）"]

    S1 --> G1["parse_server.py<br/>PDF 解析 + 分片"]
    S1 --> G2["LLM API<br/>stuff / map-reduce 摘要"]
    S1 --> G3["写回 Zotero 笔记"]

    S2 --> H1["读取 RSS abstract"]
    S2 --> H2["HTML 附件生成"]

    S3 --> I1["检查 PDF 标注"]
    S3 --> I2["zotero-better-notes<br/>模板生成结构化笔记"]

    style A fill:#4a9,stroke:#333,color:#fff
    style B fill:#26a,stroke:#333,color:#fff
    style C fill:#26a,stroke:#333,color:#fff
    style E fill:#a62,stroke:#333,color:#fff
    style F fill:#a62,stroke:#333,color:#fff
