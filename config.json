    "llm": {
        "openaiBaseUrl": "https://api.deepseek.com",
        "modelName": "deepseek-v4-flash",
        "apiKey": "sk-xxxx",
        "temperature": 0.8
    },
    "summary": {
        "chunkSize": 64000,
        "chunkOverlap": 1000,
        "maxChunk": 50,
        "only_link_file": false,
        "support_item_types": [
            "preprint",
            "journalArticle",
            "magazineArticle",
            "conferencePaper",
            "manuscript",
            "thesis",
            "webpage",
            "blogPost",
            "forumPost"
        ]
    },
    "qa": {
        "qa_enabled": true,
        "es_enabled": true,
        "saveCollectionKey": "IV5MQ9HV",
        "llm": {
            "model": "",
            "temperature": 0.8,
            "api_key": "",
            "openai_base_url": ""
        }
    },
    "work_dir": "./workspace",
    "elasticsearch": {
        "host": "http://localhost:9200",
        "index": "zotero_papers",
        "vector_dim": 1024
    },
    "zotero": {
        "api_key": "your_zotero_api_key_here",
        "library_id": "3160691",
        "library_type": "user"
    },
    "zotero_indexing": {
        "recreate_index": false,
        "item_types": [
            "journalArticle",
            "book",
            "bookSection",
            "conferencePaper",
            "thesis"
        ],
        "use_embeddings": true,
        "embedding_model": "text-embedding-v3",
        "vector_dim": 1024,
        "item_num_limit": 20,
        "document_splitting": {
            "enabled": true,
            "method": "chunk",
            "chunk_size": 10000,
            "chunk_overlap": 1000,
            "min_paragraph_length": 200,
            "section_patterns": [
                "^\\s*(?:Chapter|CHAPTER)\\s+\\d+\\s*(?::|\\.|\\s)\\s*(.+)$",
                "^\\s*\\d+\\.\\s+(.+)$",
                "^\\s*(?:Abstract|ABSTRACT)\\s*$",
                "^\\s*(?:Introduction|INTRODUCTION)\\s*$",
                "^\\s*(?:Conclusion|CONCLUSION)\\s*$"
            ]
        }
    },
    "note_export": {
        "key_names": {
            "[item]标记自动生成的层次笔记模板": "Annotation",
            "AI Generated Summary": "AI-Summary"
        },
        "notewrite_dir": "/home/xiahong/文档/zotero_notes",
        "last_save_time_file": "last_save_time.txt",
        "all_dir_name": "all",
        "new_dir_name": "new",
        "min_length": 3000,
        "ignore_last_save_time": false,
        "index_template_path": "/home/xiahong/文档/zotero_notes/note_index_template.txt"
    }
}