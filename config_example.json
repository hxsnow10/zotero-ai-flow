{
    "server": {
        "url": "http://127.0.0.1:13211",
        "timeout": 30
    },
    "llm": {
        "openaiBaseUrl": "https://api.deepseek.com",
        "modelName": "deepseek-v4-flash",
        "apiKey": "sk-xxxx",
        "temperature": 0.8
    },
    "summary": {
        "chunkSize": 64000,
        "chunkOverlap": 1000,
        "maxChunk": 50,
        "only_link_file": false,
        "support_item_types": [
            "preprint",
            "journalArticle",
            "magazineArticle",
            "conferencePaper",
            "manuscript",
            "thesis"
        ]
    },
    "qa": {
        "saveCollectionKey": "IV5MQ9HV",
        "llm": {
            "model": "",
            "temperature": 0.8,
            "api_key": "",
            "openai_base_url": ""
        }
    },
    "work_dir": "./workspace",
    "elasticsearch": {
        "host": "http://localhost:9200",
        "index": "zotero_papers",
        "vector_dim": 1024
    },
    "zotero": {
        "api_key": "Kl7Puj6BKl85FKlnnyp8vh8o",
        "library_id": "3160691",
        "library_type": "user"
    },
    "zotero_indexing": {
        "recreate_index": false,
        "item_types": [
            "journalArticle",
            "book",
            "bookSection",
            "conferencePaper",
            "thesis"
        ],
        "use_embeddings": true,
        "embedding_model": "text-embedding-v3",
        "vector_dim": 1024,
        "item_num_limit": 20,
        "document_splitting": {
            "enabled": true,
            "method": "chunk",
            "chunk_size": 10000,
            "chunk_overlap": 1000,
            "min_paragraph_length": 200,
            "section_patterns": [
                "^\\s*(?:Chapter|CHAPTER)\\s+\\d+\\s*(?::|\\.|\\s)\\s*(.+)$",
                "^\\s*\\d+\\.\\s+(.+)$",
                "^\\s*(?:Abstract|ABSTRACT)\\s*$",
                "^\\s*(?:Introduction|INTRODUCTION)\\s*$",
                "^\\s*(?:Conclusion|CONCLUSION)\\s*$"
            ]
        }
    },
    "zotero_events": {
        "_comment": "start_script.js 事件触发配置。script_dir 优先从 Zotero 插件偏好读取（编辑→设置→插件设置），此处仅作 fallback。脚本路径相对于 script_dir。",
        "script_dir": "/home/xiahong/code/zotero-ai-flow/zotero_actions",
        "debounce_ms": {
            "ui_startup": 0,
            "item_open": 2000,
            "item_close": 1000,
            "item_add": 5000
        },
        "triggers": {
            "ui_startup": [
                "zotero_autoupdate_note.js"
            ],
            "item_open": [
                "zotero_pdf_summary.js"
            ],
            "item_close": [],
            "item_add": [
                "zotero_rss.js"
            ]
        },
        "manual_triggers": {
            "_comment": "右键菜单手动触发。右键选中条目后出现「Zotero AI Flow」子菜单，点击菜单项直接执行对应脚本。",
            "menus": [
                {
                    "label": "生成 AI 摘要",
                    "script": "zotero_pdf_summary.js"
                },
                {
                    "label": "更新标注笔记",
                    "script": "zotero_autoupdate_note.js"
                },
                {
                    "label": "RSS 摘要转附件",
                    "script": "zotero_rss.js"
                },
                {
                    "label": "导出笔记",
                    "script": "zotero_export_note.js"
                }
            ]
        }
    }
}
